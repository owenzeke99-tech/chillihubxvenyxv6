AlertText.TextColor3 = Color3.fromRGB(255, 80, 80)
AlertText.TextSize = 12.000
AlertText.TextTransparency = 1

local function ShowInMenuNotice(msg, isError)
    AlertText.Text = msg
    local textColor = isError and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(80, 255, 140)
    local strokeColor = isError and Color3.fromRGB(255, 40, 50) or Color3.fromRGB(50, 220, 100)
    local bgColor = isError and Color3.fromRGB(35, 15, 18) or Color3.fromRGB(15, 35, 20)
    
    AlertText.TextColor3 = textColor
    AlertStroke.Color = strokeColor
    AlertFrame.BackgroundColor3 = bgColor
    
    TweenService:Create(AlertFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    TweenService:Create(AlertStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
    TweenService:Create(AlertText, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
    
    task.delay(3.5, function()
        TweenService:Create(AlertFrame, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenService:Create(AlertStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
        TweenService:Create(AlertText, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    end)
end

