-- Hiệu ứng Lắc & Tự Động Xóa Chữ
local isShaking = false
local function ShakeAndClearUI()
    if isShaking then return end
    isShaking = true
    
    KeyInput.Text = ""
    
    local originalPos = UDim2.new(0.5, 0, 0.5, 0)
    local shakeOffsets = { 10, -10, 7, -7, 4, -4, 2, 0 }
    
    TweenService:Create(MainStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(255, 0, 0), Thickness = 3}):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(255, 50, 50)}):Play()
    
    for _, offset in ipairs(shakeOffsets) do
        local tween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.035, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {Position = UDim2.new(0.5, offset, 0.5, 0)}
        )
        tween:Play()
        tween.Completed:Wait()
    end
    
    MainFrame.Position = originalPos
    
    TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(230, 35, 45), Thickness = 2}):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(50, 50, 55)}):Play()
    
    isShaking = false
end

-- Xử lý nút GET KEY
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(KeyLink)
        ShowInMenuNotice("KEY LINK COPIED TO CLIPBOARD!", false)
    else
        ShowInMenuNotice("EXECUTOR DOES NOT SUPPORT CLIPBOARD!", true)
    end
end)

-- Xử lý nút SUBMIT KEY
SubmitBtn.MouseButton1Click:Connect(function()
    local InputtedKey = KeyInput.Text
    
    if InputtedKey == CorrectKey then
        ShowInMenuNotice("ACCESS GRANTED! LOADING SCRIPT...", false)
        
        -- Lưu Key tự động
        SaveKeyData(InputtedKey)
        
        task.wait(0.6)
        local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.4), {BackgroundTransparency = 1})
        TweenService:Create(MainStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
        TweenService:Create(Title, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenService:Create(TitleShadow, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenService:Create(SubTitle, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        fadeOut:Play()
        
        fadeOut.Completed:Wait()
        ScreenGui:Destroy()
        
        -- Load Script chính
        loadstring(game:HttpGet(ScriptURL))()
    else
        ShowInMenuNotice("INVALID KEY! PLEASE TRY AGAIN.", true)
        ShakeAndClearUI()
    end
end)
