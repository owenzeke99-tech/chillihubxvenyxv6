local CorrectKey = "ChilliHubxVenyxV6KwyKakwiwjkeoLapqowjheiwiOqowi"
local KeyLink = "https://link4m.net/UY6kn18X"
local ScriptURL = "https://id.tomroblox.com/raw/kairoblox/chilli-x-venyx-viet-hoa-v6-vip-pro98"
local SaveFileName = "ChilliHubKey.txt"

local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- ===== HỆ THỐNG KIỂM TRA & LƯU KEY (AUTO-SAVE) =====
local function SaveKeyData(key)
    if writefile then
        local data = {
            Key = key,
            Time = os.time()
        }
        pcall(function()
            writefile(SaveFileName, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

local function LoadSavedKey()
    if isfile and readfile and isfile(SaveFileName) then
        local success, result = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(SaveFileName))
        end)
        
        if success and type(result) == "table" then
            local savedKey = result.Key
            local savedTime = result.Time or 0
            local currentTime = os.time()
            
            -- Kiểm tra xem đã quá 24 giờ (86400 giây) hay chưa
            if (currentTime - savedTime) < 86400 then
                if savedKey == CorrectKey then
                    return true
                end
            end
        end
    end
    return false
end

-- Tự động bỏ qua Bảng Key nếu đã lưu Key hợp lệ còn thời hạn
if LoadSavedKey() then
    loadstring(game:HttpGet(ScriptURL))()
    return
end

